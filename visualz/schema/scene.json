{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,100}$"
    },
    "name": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "pixel-eye",
        "kaleido",
        "prism",
        "liquid",
        "opart",
        "plasma",
        "chromascope",
        "gallery"
      ]
    },
    "mode_params": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "number",
          "string",
          "boolean",
          "null"
        ]
      }
    },
    "look": {
      "type": "object",
      "properties": {
        "style": {
          "enum": [
            "none",
            "pixel",
            "halftone"
          ]
        },
        "pixel_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "colour_depth": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 4,
              "maximum": 256
            },
            {
              "const": "full"
            }
          ]
        },
        "dither": {
          "type": "boolean"
        },
        "palette": {
          "type": "string"
        },
        "brightness": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "contrast": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        },
        "saturation": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        },
        "speed": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "reactivity": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "halftone": {
          "type": "object",
          "properties": {
            "dot_size": {
              "type": "number",
              "minimum": 1,
              "maximum": 64
            },
            "angle": {
              "type": "number",
              "minimum": -360,
              "maximum": 360
            },
            "shape": {
              "enum": [
                "dot",
                "line",
                "diamond"
              ]
            },
            "style": {
              "enum": [
                "mono",
                "duotone",
                "cmyk"
              ]
            },
            "ink": {
              "type": "string",
              "pattern": "^(#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?|@(primary|accent|text|background))$"
            },
            "paper": {
              "type": "string",
              "pattern": "^(#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?|@(primary|accent|text|background))$"
            },
            "audio_pulse": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            }
          },
          "required": [
            "dot_size",
            "angle",
            "shape",
            "style",
            "ink",
            "paper",
            "audio_pulse"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "style",
        "pixel_size",
        "colour_depth",
        "dither",
        "palette",
        "brightness",
        "contrast",
        "saturation",
        "speed",
        "reactivity",
        "halftone"
      ],
      "additionalProperties": false
    },
    "quality": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "source_asset": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^assets/[a-zA-Z0-9_][a-zA-Z0-9_.-]*(?:/[a-zA-Z0-9_][a-zA-Z0-9_.-]*)*$",
          "maxLength": 240
        },
        {
          "type": "null"
        }
      ]
    },
    "picture_set": {
      "type": [
        "string",
        "null"
      ]
    },
    "order": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    }
  },
  "required": [
    "id",
    "name",
    "mode",
    "mode_params",
    "look"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
