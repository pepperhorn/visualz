{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,100}$"
    },
    "path": {
      "type": "string",
      "pattern": "^assets/[a-zA-Z0-9_][a-zA-Z0-9_.-]*(?:/[a-zA-Z0-9_][a-zA-Z0-9_.-]*)*$",
      "maxLength": 240
    },
    "original": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^assets/[a-zA-Z0-9_][a-zA-Z0-9_.-]*(?:/[a-zA-Z0-9_][a-zA-Z0-9_.-]*)*$",
          "maxLength": 240
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "enum": [
        "image",
        "logo",
        "clip",
        "font"
      ]
    },
    "name": {
      "type": "string"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "id",
    "path",
    "original",
    "kind",
    "name",
    "warnings"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
