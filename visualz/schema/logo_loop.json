{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "fps",
    "duration",
    "frames"
  ],
  "additionalProperties": false,
  "properties": {
    "fps": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 30
    },
    "duration": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 10
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 300,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9_-]+\\.png$"
      }
    }
  }
}
